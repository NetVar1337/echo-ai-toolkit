#!/usr/bin/env bash
# echo — the Echo toolkit CLI.
#
#   echo                     start Pi with the Echo profile
#   echo <pi args…>          pass everything through to Pi
#   echo -- <pi args…>       force pass-through (for prompts that look like commands)
#
#   echo update [flags]      update toolkit, profile, Pi, and the pinned tools
#   echo doctor              verify what is installed
#   echo status              one-screen summary
#   echo tools               list installed companion tools
#   echo version             versions of everything
#   echo help                this message
#
# `echo update` flags: --extensions --self --models --all --force (Pi's own)
#                      --tools --profile --lock (Echo's)
#
# The Pi profile lives in $ECHO_HOME/pi and is selected with PI_CODING_AGENT_DIR,
# so your normal `pi` configuration is left untouched. The subcommands live in
# echo.mjs — one implementation for every platform.
set -uo pipefail

ECHO_HOME="${ECHO_HOME:-$HOME/.local/share/echo-ai-toolkit}"
PROFILE="$ECHO_HOME/pi"
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"

have() { command -v "$1" >/dev/null 2>&1; }

cli() { # path to echo.mjs — beside the launcher, in the repo, or installed
  local cand
  for cand in "$SELF_DIR/echo.mjs" "$SELF_DIR/../../scripts/echo.mjs" "$ECHO_HOME/bin/echo.mjs"; do
    [ -f "$cand" ] && { printf '%s' "$cand"; return 0; }
  done
  return 1
}

# `echo -- …` forces pass-through, for a prompt that starts with a command name.
if [ "${1:-}" = "--" ]; then
  shift
else
  cmd="${1:-}"
  case "$cmd" in
    update|doctor|status|tools|version|--version|-V|help|--help|-h)
      path="$(cli)" || {
        printf '\033[1;31mecho:\033[0m echo.mjs not found (re-run the installer)\n' >&2
        exit 1
      }
      have node || {
        printf '\033[1;31mecho:\033[0m node not found — the CLI needs Node 18+\n' >&2
        exit 1
      }
      shift
      exec node "$path" "$cmd" "$@"
      ;;
  esac
fi

# ── default: launch Pi ───────────────────────────────────────────────────────
if ! have pi; then
  cat >&2 <<'MSG'
echo: `pi` is not installed.

  curl -fsSL https://pi.dev/install.sh | sh
  # or: npm install -g --ignore-scripts @earendil-works/pi-coding-agent

Pi needs Node.js 22.19 or newer. Everything else still works:
  echo doctor    verify the toolkit
  echo update    update everything
MSG
  exit 127
fi

if [ ! -f "$PROFILE/SYSTEM.md" ]; then
  printf '\033[1;31mecho:\033[0m Echo profile missing at %s\n' "$PROFILE" >&2
  printf 'Re-run the toolkit installer, or:  echo update --profile\n' >&2
  exit 1
fi

export PI_CODING_AGENT_DIR="$PROFILE"

args=(--system-prompt "$PROFILE/SYSTEM.md")
[ -f "$PROFILE/APPEND_SYSTEM.md" ] && args+=(--append-system-prompt "$PROFILE/APPEND_SYSTEM.md")

exec pi "${args[@]}" "$@"
