// ============================================================================
// AI MENU CONTROL — portable drop-in lane (paste into any Angel script)
// ============================================================================
// Exposes a WebSocket lane (ui_list / ui_get / ui_set) that an external AI / MCP client
// (the angel-menu-mcp server) uses to enumerate and toggle THIS script's menu — for automated
// testing. Control set/read goes through the STORED handle (live-verified: ui::get/ui::set on a
// stored copy track the real control), so this file is fully control-agnostic — the per-script
// registry is generated by generate-registry.mjs (names each control by its m_<var> global).
//
// INTEGRATION (see INTEGRATION.md):
//   1. Paste this file's contents into your script (once).
//   2. Run:  node generate-registry.mjs your_script.as   -> paste the amc_build_registry() it prints.
//   3. In build_menu(), after your controls: amc_add_buttons();
//   4. In main(), after build_menu():          amc_build_registry();
//   5. In your render callback, first line:     amc_render();
//   6. In on_unload():                          amc_on_unload();
//
// SINGLE ws:: SOCKET: the host allows one ws:: connection per script. If this script also uses
// ws:: (e.g. WebRadar), only one may be connected at a time — disconnect the other before
// clicking "AI Menu Control: Connect".
//
// SAFETY: controls whose registration passed danger=true (anything that writes game memory)
// refuse ui_set unless the operator clicks "AI Menu Control: ARM" in the overlay. Arming is a
// live human click, never a wire verb.

const string AMC_URL = "ws://127.0.0.1:9010/agent-ui"; // must match angel-menu-mcp's port/path

const int AMC_CHECK = 0, AMC_SLIDER = 1, AMC_COMBO = 2, AMC_MULTI = 3, AMC_COLOR = 4;

class AmcCtl
{
    string name;
    string label;             // human menu label (the ui::add_* first arg); falls back to name
    int    kind;
    bool   danger;
    bool   writable;          // check/slider/combo -> true; multi/color -> read-only in v1
    string tab;               // overlay tab this control lives under (from amc_tab)
    string subtab;            // overlay sub-tab (from amc_subtab)
    string category;          // overlay category (from amc_category)
    checkbox     cb;
    slider       sl;
    combobox     co;
    multi_select ms;
    color_picker cp;
    int mn, mx, st;           // slider
    array<string> options;    // combo/multi labels
}
array<AmcCtl> g_amc;          // built once in amc_build_registry(); read-only after

// Running tab/category context, mirroring the overlay's own ui::add_tab / ui::add_category calls.
// The generated amc_build_registry() calls amc_tab()/amc_category() so the registry keeps the
// menu's structure; each amc_* registration stamps the current tab/category onto the control.
string g_amc_cur_tab = "";
string g_amc_cur_sub = "";
string g_amc_cur_cat = "";
void amc_tab(const string &in t)      { g_amc_cur_tab = t; g_amc_cur_sub = ""; g_amc_cur_cat = ""; }
void amc_subtab(const string &in s)   { g_amc_cur_sub = s; g_amc_cur_cat = ""; }
void amc_category(const string &in c) { g_amc_cur_cat = c; }

// queued ui_set requests, applied on the render thread by amc_render()
class AmcSetReq { string id; int idx; bool bval; int ival; }
mutex@ g_amc_qmtx = create_mutex();
array<AmcSetReq> g_amc_q;

// lane state
bool g_amc_active = false;                  // true while connected
atomic_bool@ g_amc_armed     = atomic_bool(false); // danger-control arm
atomic_bool@ g_amc_unloading = atomic_bool(false); // set by amc_on_unload()
atomic_int32@ g_amc_busy     = atomic_int32(0);    // in-flight ws callbacks (drain on unload)

// buttons (added by amc_add_buttons())
button g_amc_btn_connect, g_amc_btn_disconnect, g_amc_btn_arm, g_amc_btn_disarm;

// ── registration helpers (the generated amc_build_registry() calls these) ────
void amc_check(const string &in name, checkbox &in c, const string &in label = "", bool danger = false)
{
    AmcCtl u; u.name = name; u.label = (label == "" ? name : label); u.kind = AMC_CHECK; u.danger = danger; u.writable = true; u.cb = c;
    u.tab = g_amc_cur_tab; u.subtab = g_amc_cur_sub; u.category = g_amc_cur_cat;
    g_amc.insertLast(u);
}
void amc_slider(const string &in name, slider &in s, int mn, int mx, int st, const string &in label = "", bool danger = false)
{
    AmcCtl u; u.name = name; u.label = (label == "" ? name : label); u.kind = AMC_SLIDER; u.danger = danger; u.writable = true; u.sl = s;
    u.mn = mn; u.mx = mx; u.st = st;
    u.tab = g_amc_cur_tab; u.subtab = g_amc_cur_sub; u.category = g_amc_cur_cat;
    g_amc.insertLast(u);
}
void amc_combo(const string &in name, combobox &in c, const string &in optsCsv, const string &in label = "", bool danger = false)
{
    AmcCtl u; u.name = name; u.label = (label == "" ? name : label); u.kind = AMC_COMBO; u.danger = danger; u.writable = true; u.co = c;
    amc_split_csv(optsCsv, u.options);
    u.tab = g_amc_cur_tab; u.subtab = g_amc_cur_sub; u.category = g_amc_cur_cat;
    g_amc.insertLast(u);
}
void amc_multi(const string &in name, multi_select &in m, const string &in optsCsv, const string &in label = "", bool danger = false)
{
    AmcCtl u; u.name = name; u.label = (label == "" ? name : label); u.kind = AMC_MULTI; u.danger = danger; u.writable = false; u.ms = m;
    amc_split_csv(optsCsv, u.options);
    u.tab = g_amc_cur_tab; u.subtab = g_amc_cur_sub; u.category = g_amc_cur_cat;
    g_amc.insertLast(u);
}
void amc_color(const string &in name, color_picker &in c, const string &in label = "", bool danger = false)
{
    AmcCtl u; u.name = name; u.label = (label == "" ? name : label); u.kind = AMC_COLOR; u.danger = danger; u.writable = false; u.cp = c;
    u.tab = g_amc_cur_tab; u.subtab = g_amc_cur_sub; u.category = g_amc_cur_cat;
    g_amc.insertLast(u);
}

void amc_split_csv(const string &in csv, array<string> &inout dst)
{
    string cur = "";
    for (uint i = 0; i < csv.length(); i++)
    {
        if (csv[i] == 44) { dst.insertLast(cur); cur = ""; }   // 44 = ','
        else cur += csv.substr(i, 1);
    }
    if (cur != "") dst.insertLast(cur);
}
int amc_find(const string &in name)
{
    for (uint i = 0; i < g_amc.length(); i++) if (g_amc[i].name == name) return int(i);
    return -1;
}
string amc_kind_name(int k)
{
    if (k == AMC_CHECK)  return "check";
    if (k == AMC_SLIDER) return "slider";
    if (k == AMC_COMBO)  return "combo";
    if (k == AMC_MULTI)  return "multi";
    return "color";
}

// ── value read via STORED handle (live) ─────────────────────────────────────
string amc_value_json(AmcCtl@ u)
{
    if (u.kind == AMC_CHECK)  return ui::get(u.cb) ? "true" : "false";
    if (u.kind == AMC_SLIDER) return "" + ui::get(u.sl);
    if (u.kind == AMC_COMBO)  return "" + int(ui::get(u.co));
    if (u.kind == AMC_MULTI)
    {
        string a = "[";
        for (uint i = 0; i < u.options.length(); i++)
            a += (i > 0 ? "," : "") + (ui::get(u.ms, uint64(i)) ? "true" : "false");
        return a + "]";
    }
    color c = ui::get(u.cp);   // AMC_COLOR
    return "\"" + c.r + "," + c.g + "," + c.b + "," + c.a + "\"";
}

// ── minimal JSON scalar parsing (self-contained; no external helpers) ────────
string amc_json_str(const string &in f, const string &in key, const string &in def)
{
    string pat = "\"" + key + "\"";
    int k = f.findFirst(pat);
    if (k < 0) return def;
    int c = f.findFirst(":", uint(k) + pat.length());
    if (c < 0) return def;
    int q = f.findFirst("\"", uint(c) + 1);
    if (q < 0) return def;
    uint i = uint(q) + 1;
    string v = "";
    while (i < f.length() && f[i] != 34)   // 34 = '"'
    {
        if (f[i] == 92 && i + 1 < f.length()) { v += f.substr(i + 1, 1); i += 2; continue; }
        v += f.substr(i, 1); i++;
    }
    return v;
}
bool amc_json_has(const string &in f, const string &in key) { return f.findFirst("\"" + key + "\"") >= 0; }
bool amc_json_bool(const string &in f, const string &in key, bool def)
{
    int p = f.findFirst("\"" + key + "\"");
    if (p < 0) return def;
    int c = f.findFirst(":", uint(p));
    if (c < 0) return def;
    uint i = uint(c) + 1;
    while (i < f.length() && (f[i] == 0x20 || f[i] == 0x09)) i++;
    return i < f.length() && f[i] == 't'[0];
}
int amc_json_int(const string &in f, const string &in key, int def)
{
    int p = f.findFirst("\"" + key + "\"");
    if (p < 0) return def;
    int c = f.findFirst(":", uint(p));
    if (c < 0) return def;
    uint i = uint(c) + 1;
    while (i < f.length() && (f[i] == 0x20 || f[i] == 0x09)) i++;
    bool neg = false;
    if (i < f.length() && f[i] == '-'[0]) { neg = true; i++; }
    bool any = false; int v = 0;
    while (i < f.length()) { uint8 ch = f[i]; if (ch < 48 || ch > 57) break; v = v * 10 + int(ch - 48); any = true; i++; }
    if (!any) return def;
    return neg ? -v : v;
}
string amc_extract_id(const string &in s)
{
    int p = s.findFirst("\"id\"");
    if (p < 0) return "0";
    int c = s.findFirst(":", uint(p) + 4);
    if (c < 0) return "0";
    uint i = uint(c) + 1;
    while (i < s.length() && s[i] == 0x20) i++;
    uint j = i;
    while (j < s.length()) { uint8 ch = s[j]; if (ch < 48 || ch > 57) break; j++; }
    if (j == i) return "0";
    return s.substr(i, j - i);
}
string amc_json_escape(const string &in src)
{
    string r = "";
    for (uint i = 0; i < src.length(); i++)
    {
        uint8 ch = src[i];
        if (ch == 34 || ch == 92) { r += "\\"; r += src.substr(i, 1); }
        else if (ch >= 0x20) r += src.substr(i, 1);
    }
    return r;
}
void amc_err(const string &in id, int code, const string &in msg)
{
    ws::send("{\"type\":\"error\",\"id\":" + id + ",\"code\":" + code + ",\"message\":\"" + amc_json_escape(msg) + "\"}");
}

// ── verb handlers ───────────────────────────────────────────────────────────
void amc_handle_list(const string &in id)
{
    string rows = "";
    for (uint i = 0; i < g_amc.length(); i++)
    {
        AmcCtl@ u = g_amc[i];
        if (i > 0) rows += ",";
        rows += "{\"name\":\"" + amc_json_escape(u.name) + "\",\"label\":\"" + amc_json_escape(u.label) + "\",\"kind\":\"" + amc_kind_name(u.kind)
              + "\",\"value\":" + amc_value_json(u)
              + ",\"writable\":" + (u.writable ? "true" : "false")
              + ",\"danger\":" + (u.danger ? "true" : "false")
              + ",\"tab\":\"" + amc_json_escape(u.tab) + "\",\"subtab\":\"" + amc_json_escape(u.subtab) + "\",\"category\":\"" + amc_json_escape(u.category) + "\"";
        if (u.kind == AMC_SLIDER)
            rows += ",\"min\":" + u.mn + ",\"max\":" + u.mx + ",\"step\":" + u.st;
        if (u.kind == AMC_COMBO || u.kind == AMC_MULTI)
        {
            rows += ",\"options\":[";
            for (uint k = 0; k < u.options.length(); k++)
                rows += (k > 0 ? "," : "") + "\"" + amc_json_escape(u.options[k]) + "\"";
            rows += "]";
        }
        rows += "}";
    }
    ws::send("{\"type\":\"ui_list_result\",\"id\":" + id + ",\"count\":" + g_amc.length()
             + ",\"results\":[" + rows + "]}");
}
void amc_handle_get(const string &in frame, const string &in id)
{
    string name = amc_json_str(frame, "name", "");
    int i = amc_find(name);
    if (i < 0) { amc_err(id, 1030, "unknown control: " + name); return; }
    AmcCtl@ u = g_amc[uint(i)];
    ws::send("{\"type\":\"ui_get_result\",\"id\":" + id + ",\"name\":\"" + amc_json_escape(name)
             + "\",\"kind\":\"" + amc_kind_name(u.kind) + "\",\"value\":" + amc_value_json(u) + "}");
}
void amc_handle_set(const string &in frame, const string &in id)
{
    string name = amc_json_str(frame, "name", "");
    int i = amc_find(name);
    if (i < 0) { amc_err(id, 1030, "unknown control: " + name); return; }
    AmcCtl@ u = g_amc[uint(i)];
    if (!u.writable) { amc_err(id, 1032, "read-only control (" + amc_kind_name(u.kind) + "): " + name); return; }
    if (u.danger && !g_amc_armed.load())
    { amc_err(id, 1005, "danger control disarmed: " + name + " (click 'AI Menu Control: ARM' in the overlay)"); return; }
    if (!amc_json_has(frame, "value")) { amc_err(id, 1031, "missing value"); return; }

    AmcSetReq r; r.id = id; r.idx = i;
    if (u.kind == AMC_CHECK)
        r.bval = amc_json_bool(frame, "value", false) || amc_json_int(frame, "value", 0) != 0;
    else
    {
        int v = amc_json_int(frame, "value", 0);
        if (u.kind == AMC_SLIDER) { if (v < u.mn) v = u.mn; if (v > u.mx) v = u.mx; }
        else { int oc = int(u.options.length()); if (v < 0) v = 0; if (oc > 0 && v >= oc) v = oc - 1; }
        r.ival = v;
    }
    g_amc_qmtx.lock();
    g_amc_q.insertLast(r);
    g_amc_qmtx.unlock();
}

// ── RENDER-THREAD: drain + apply queued sets, reply per applied control ──────
// Call amc_render() as the first line of your render callback.
void amc_render()
{
    if (!g_amc_active)
    {
        g_amc_qmtx.lock();
        if (g_amc_q.length() != 0) g_amc_q.resize(0);
        g_amc_qmtx.unlock();
        return;
    }
    g_amc_qmtx.lock();
    if (g_amc_q.length() == 0) { g_amc_qmtx.unlock(); return; }
    array<AmcSetReq> batch = g_amc_q;
    g_amc_q.resize(0);
    g_amc_qmtx.unlock();

    for (uint i = 0; i < batch.length(); i++)
    {
        AmcSetReq@ r = batch[i];
        if (r.idx < 0 || r.idx >= int(g_amc.length())) continue;
        AmcCtl@ u = g_amc[uint(r.idx)];
        if      (u.kind == AMC_CHECK)  ui::set(u.cb, r.bval);   // set through the STORED handle (live)
        else if (u.kind == AMC_SLIDER) ui::set(u.sl, r.ival);
        else if (u.kind == AMC_COMBO)  ui::set(u.co, r.ival);
        // echo the APPLIED value (reads can lag a frame; we just wrote this, so it's the truth)
        string applied = (u.kind == AMC_CHECK) ? (r.bval ? "true" : "false") : ("" + r.ival);
        ws::send("{\"type\":\"ui_set_result\",\"id\":" + r.id + ",\"success\":true,\"name\":\""
                 + amc_json_escape(u.name) + "\",\"kind\":\"" + amc_kind_name(u.kind)
                 + "\",\"value\":" + applied + "}");
    }
}

// ── ws:: lane plumbing ──────────────────────────────────────────────────────
void amc_on_open()  { alert::show_tag("AI Menu Control: connected (/agent-ui)", "amc", 80, 255, 120); }
void amc_on_msg(string msg)
{
    // busy-count around dispatch so amc_on_unload()'s drain waits for an in-flight handler
    { int c = g_amc_busy.load(); while (true) { int e = c; int s = g_amc_busy.compare_exchange(e, c + 1); if (s == c) break; c = s; } }
    if (!g_amc_unloading.load())
    {
        string type = amc_json_str(msg, "type", "");
        string id   = amc_extract_id(msg);
        if      (type == "ui_list") amc_handle_list(id);
        else if (type == "ui_get")  amc_handle_get(msg, id);
        else if (type == "ui_set")  amc_handle_set(msg, id);
        else amc_err(id, 1000, "unknown ui verb: " + type);
    }
    { int c = g_amc_busy.load(); while (true) { int e = c; int s = g_amc_busy.compare_exchange(e, c - 1); if (s == c) break; c = s; } }
}
void amc_on_close() { g_amc_active = false; g_amc_armed.store(false); alert::show_tag("AI Menu Control: disconnected", "amc", 255, 160, 40); }
void amc_on_err(string err) { g_amc_active = false; g_amc_armed.store(false); alert::show_tag("AI Menu Control: ws error — " + err, "amc", 255, 80, 80); }

void amc_connect()
{
    if (g_amc_unloading.load()) return;
    if (g_amc_active) { alert::show_tag("AI Menu Control: already connected", "amc", 255, 200, 40); return; }
    g_amc_active = true;   // optimistic; on_err/on_close clears it if the socket won't open
    ws::connect(AMC_URL, @amc_on_open, @amc_on_msg, @amc_on_close, @amc_on_err);
}
void amc_disconnect()
{
    if (!g_amc_active) return;
    g_amc_active = false;
    g_amc_armed.store(false);
    ws::disconnect();
    alert::show_tag("AI Menu Control: disconnected", "amc", 200, 200, 200);
}
void amc_arm()
{
    if (!g_amc_active) { alert::show_tag("AI Menu Control: connect first", "amc", 255, 160, 40); return; }
    g_amc_armed.store(true);
    alert::show_tag("AI Menu Control: danger controls ARMED", "amc", 255, 110, 40);
}
void amc_disarm() { g_amc_armed.store(false); alert::show_tag("AI Menu Control: danger controls disarmed", "amc", 200, 200, 200); }

void amc_on_connect_click()    { amc_connect(); }
void amc_on_disconnect_click() { amc_disconnect(); }
void amc_on_arm_click()        { amc_arm(); }
void amc_on_disarm_click()     { amc_disarm(); }

// Call inside build_menu() (e.g. in a "Debug" or "Misc" category).
void amc_add_buttons()
{
    g_amc_btn_connect    = ui::add_button("AI Menu Control: Connect", @amc_on_connect_click);
    g_amc_btn_disconnect = ui::add_button("AI Menu Control: Disconnect", @amc_on_disconnect_click);
    g_amc_btn_arm        = ui::add_button("AI Menu Control: ARM danger controls (DANGEROUS)", @amc_on_arm_click);
    g_amc_btn_disarm     = ui::add_button("AI Menu Control: Disarm danger controls", @amc_on_disarm_click);
}

// Call from on_unload(): stop new work, drain in-flight handlers, drop the socket + arm.
void amc_on_unload()
{
    g_amc_unloading.store(true);
    g_amc_armed.store(false);
    uint64 dl = util::tickcount() + 2000;
    while (g_amc_busy.load() != 0 && util::tickcount() < dl) {}
    if (g_amc_active) { g_amc_active = false; ws::disconnect(); }
}
